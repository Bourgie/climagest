# ═══════════════════════════════════════════════════════════
# App de Gestión para Empresas de Aire Acondicionado — .env.example
# Copiar como .env.local y completar con valores reales.
# NUNCA commitear .env.local ni los secretos (ver .gitignore).
# Este archivo (template sin valores) SÍ se versiona.
# ═══════════════════════════════════════════════════════════

# ── Supabase (público — puede ir en el browser) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase (SECRETO — solo servidor, nunca en el frontend) ──
SUPABASE_SERVICE_ROLE_KEY=

# ── PowerSync (público — endpoint de la instancia PowerSync Cloud) ──
NEXT_PUBLIC_POWER_SYNC_URL=

# ── Supabase CLI (migraciones) — no va en runtime, solo dev ──
# Usado por `supabase db push --db-url "$SUPABASE_DB_URL"` (sin `supabase link`).
# IMPORTANTE: usar el POOLER IPv4 (no el host directo, que es solo IPv6), y el
# usuario `postgres.<project_ref>` (no `postgres`).
# SUPABASE_DB_URL=postgresql://postgres.<project_ref>:<db_password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=

# ── URL de producción (para dominios permitidos en Supabase Auth) ──
NEXT_PUBLIC_APP_URL=

# ── Cron / Jobs (secreto para endpoint /api/cron protegido) ──
CRON_SECRET=

# ── Seed de desarrollo (solo dev, nunca datos reales) ──
SEED_SUPERUSER_PASSWORD=
SEED_DEMO_PASSWORD=